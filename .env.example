# Image built from this Git stack.
OMEGA_BUILD_CONTEXT=.
OMEGA_IMAGE=gamemaster:latest

# Omega startup configuration.
OMEGA_COMMCHANNEL=irc
OMEGA_PROVIDER=ASICloud
OMEGA_EMBEDDING_PROVIDER=Local
OMEGA_AUTH_SECRET=change-me
OMEGA_SECURITY_POLICY_PATH=/PeTTa/repos/Omega/profile/policy.yaml
IMPORT_KB_ON_START=0
ASI_API_KEY=

# Tabletop runtime selection.
TABLETOP_WORKSPACE=campaign
TABLETOP_CAMPAIGN=
TABLETOP_PARTICIPANT_GM=
TABLETOP_PARTICIPANT_ADA=ada
TABLETOP_PARTICIPANT_BO=bo
OMEGA_EXPECTED_SENDER_GM=
OMEGA_EXPECTED_SENDER_ADA=
OMEGA_EXPECTED_SENDER_BO=
OMEGA_COMMCHANNEL_GM=
OMEGA_COMMCHANNEL_ADA=telegram
OMEGA_COMMCHANNEL_BO=telegram
# Busy-timeout ceiling measured in e-concurrency-proof (ms).
TABLETOP_SQLITE_BUSY_TIMEOUT_MS=5000

# Persistent Docker volume names and their container paths.
OMEGA_MEMORY_VOLUME=gamemaster-omega-memory
OMEGA_MEMORY_PATH=/PeTTa/repos/Omega/memory
TABLETOP_STATE_VOLUME=gamemaster-tabletop-state
TABLETOP_STATE_PATH=/PeTTa/repos/Omega/tabletop/data
TABLETOP_DATABASE_PATH=/PeTTa/repos/Omega/tabletop/data/tabletop.sqlite3

# Git-stack bind mounts. Relative defaults resolve from the stack directory.
TABLETOP_PLUGIN_HOST_PATH=./plugins
TABLETOP_PLUGIN_MOUNT=/mnt/gamemaster/plugins
TABLETOP_CONTAINER_PLUGIN_PATH=/PeTTa/repos/Omega/plugins
TABLETOP_LIBRARY_HOST_PATH=./library
TABLETOP_LIBRARY_MOUNT=/mnt/gamemaster/library
TABLETOP_CONTAINER_LIBRARY_PATH=/PeTTa/repos/Omega/library
TABLETOP_CAMPAIGNS_HOST_PATH=./campaigns
TABLETOP_CAMPAIGNS_MOUNT=/mnt/gamemaster/campaigns
TABLETOP_CONTAINER_CAMPAIGNS_PATH=/PeTTa/repos/Omega/campaigns

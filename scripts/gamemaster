#!/usr/bin/env bash
# Operator CLI wrapper. Delegates to python -m tabletop.cli.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
if command -v python3.11 >/dev/null 2>&1; then
  PYTHON_BIN=python3.11
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN=python3
else
  PYTHON_BIN=python
fi
exec "${PYTHON:-$PYTHON_BIN}" -m tabletop.cli "$@"
